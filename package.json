{
    "name": "@flippo-software/ui-kit-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.24.0",
    "scripts": {
        "build": "pnpm --recursive build",
        "typecheck": "pnpm --recursive typecheck",
        "lint:check": "pnpm --recursive lint:check",
        "test": "pnpm --recursive test",
        "check": "pnpm build && pnpm lint:check && pnpm typecheck && pnpm test",
        "storybook:react": "pnpm --filter @flippo-software/ui-kit-react storybook",
        "storybook:web": "pnpm --filter @flippo-software/ui-kit-web storybook"
    }
}
