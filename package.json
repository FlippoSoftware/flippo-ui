{
  "name": "@flippo/internal-test-utils",
  "version": "1.0.0",
  "description": "Internal testing utilities for Flippo headless UI components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "testing",
    "test-utils",
    "headless-ui",
    "react",
    "flippo",
    "internal"
  ],
  "author": "@BlackPoretsky",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/ui": "^3.2.4",
    "jsdom": "^24.1.3",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "tsup": "^8.4.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlippoSoftware/internal-test-utils.git"
  },
  "homepage": "https://github.com/FlippoSoftware/internal-test-utils#readme",
  "bugs": {
    "url": "https://github.com/FlippoSoftware/internal-test-utils/issues"
  },
  "sideEffects": false
}
