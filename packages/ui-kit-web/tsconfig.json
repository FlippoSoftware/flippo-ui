{
    "extends": "@flippo-software/tsconfig",
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "ES2024"],
        "jsx": "react-jsx",
        "types": ["node", "react", "react-dom"],
        "composite": false,
        "customConditions": ["source"],
        "incremental": false,
        "paths": {
            "~@src": ["./src/index.ts"],
            "~@src/*": ["./src/*"],
            "~@lib/*": ["./src/lib/*"],
            "~@components/*": ["./src/components/*"],
            "~@stories": ["./src/__stories__/index.ts"]
        }
    },
    "include": [
        "src",
        "tsdown.config.ts",
        "aliases.ts",
        "vitest.config.ts",
        ".storybook/main.ts",
        ".storybook/preview.ts",
        ".storybook/env.d.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
