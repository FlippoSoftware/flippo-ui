{
    "extends": ["@flippo-software/biome/base", "@flippo-software/biome/test"],
    "files": {
        "includes": [
            "!**/node_modules",
            "!**/dist",
            "!**/.git",
            "!**/.storybook",
            "!**/scripts",
            "!**/vite.config.ts",
            "!**/src/vite-env.d.ts",
            "!**/storybook-static"
        ]
    },
    "root": false,
    "linter": {
        "rules": {
            "performance": {
                "noReExportAll": "off",
                "noBarrelFile": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/__tests__/**", "*.config.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "noNonNullAssertion": "off",
                        "useFilenamingConvention": "off"
                    },
                    "performance": {
                        "useTopLevelRegex": "off"
                    },
                    "correctness": {
                        "noNodejsModules": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/__stories__/**"],
            "linter": {
                "rules": {
                    "style": {
                        "noDefaultExport": "off",
                        "useFilenamingConvention": "off",
                        "useComponentExportOnlyModules": "off"
                    },
                    "performance": {
                        "useTopLevelRegex": "off"
                    },
                    "security": {
                        "noSecrets": "off"
                    }
                }
            }
        }
    ]
}
