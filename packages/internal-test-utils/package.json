{
    "name": "@flippo-software/internal-test-utils",
    "private": true,
    "version": "1.0.0",
    "description": "Internal testing utilities for Flippo headless UI components",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test:ui": "vitest --ui"
    },
    "keywords": [
        "testing",
        "test-utils",
        "headless-ui",
        "react",
        "flippo",
        "internal"
    ],
    "author": "@BlackPoretsky",
    "license": "ISC",
    "dependencies": {
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@vitest/ui": "^3.2.4",
        "jsdom": "^24.1.3",
        "vitest": "^3.2.4"
    },
    "devDependencies": {
        "@types/node": "^22.18.0",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "tsup": "^8.4.0",
        "typescript": "^5.9.2"
    },
    "peerDependencies": {
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "vitest": "^3.2.4"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlippoSoftware/flippo-components.git",
        "directory": "packages/internal-test-utils"
    },
    "homepage": "https://github.com/FlippoSoftware/flippo-components/tree/main/packages/internal-test-utils#readme",
    "bugs": {
        "url": "https://github.com/FlippoSoftware/flippo-components/issues"
    },
    "sideEffects": false
}
