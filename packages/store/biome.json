{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "root": false,
    "extends": ["@flippo-software/biome/base", "@flippo-software/biome/test"],
    "plugins": ["./node_modules/@flippo-software/biome/src/plugins/no-node-process-import/no-node-process-import.grit"],
    "linter": {
        "rules": {
            "performance": {
                "noReExportAll": "off",
                "noBarrelFile": "off"
            },
            "style": {
                "noRestrictedImports": {
                    "level": "error",
                    "options": {
                        "patterns": [
                            {
                                "group": ["react", "react/*", "react-dom", "react-dom/*"],
                                "message": "@flippo-software/store must stay framework-agnostic."
                            }
                        ]
                    }
                }
            }
        }
    },
    "overrides": [
        {
            "includes": ["src/**/*.test.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        }
    ]
}
