{
    "name": "@flippo-software/web-components",
    "type": "module",
    "version": "0.1.0",
    "description": "Headless, framework-agnostic web components built on the Flippo UI state machines.",
    "author": "BlackPoretsky (Egor Gorochkin)",
    "license": "ISC",
    "keywords": [
        "web-components",
        "custom-elements",
        "headless",
        "accessibility",
        "flippo"
    ],
    "sideEffects": false,
    "files": [
        "README.md",
        "dist",
        "skills"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "lint:check": "biome check",
        "lint:fix": "biome lint --fix && biome format --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@flippo-software/core-components": "workspace:^",
        "@flippo-software/store": "workspace:^"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@flippo-software/biome": "catalog:",
        "@flippo-software/tsconfig": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "happy-dom": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vue": "^3.5.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/FlippoSoftware/flippo-components.git",
        "directory": "packages/web-components"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
