{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "root": false,
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "defaultBranch": "main"
    },
    "extends": ["@flippo-software/biome/base", "@flippo-software/biome/react", "@flippo-software/biome/test"],
    "plugins": [
        "./node_modules/@flippo-software/biome/src/plugins/no-node-process-import/no-node-process-import.grit",
        "./node_modules/@flippo-software/biome/src/plugins/effector/biome-plugin-effector.grit"
    ],
    "linter": {
        "rules": {
            "performance": {
                "noReExportAll": "off",
                "noBarrelFile": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": ["scripts/**"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noNodejsModules": "off"
                    },
                    "suspicious": {
                        "noConsole": "off"
                    },
                    "style": {
                        "useFilenamingConvention": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/*.test.ts", "**/*.test.tsx", "src/components/Tabs/indicator/prehydrationScript.*"],
            "linter": {
                "rules": {
                    "security": {
                        "noSecrets": "off"
                    }
                }
            }
        }
    ],
    "javascript": {
        "jsxRuntime": "reactClassic"
    }
}
