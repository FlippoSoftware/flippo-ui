{
    "name": "@flippo-software/workspace-tools",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Development wiring shared by the packages of the workspace (Vite/Vitest conditions, aliases), the Storybook theme and docs pages, and release scripts.",
    "exports": {
        ".": "./workspace.ts",
        "./storybook": "./storybook/index.ts",
        "./storybook/theme": "./storybook/theme.ts",
        "./storybook/i18n": "./storybook/i18n.ts",
        "./docs-hash": "./docs-hash.ts",
        "./core-enums": "./core-enums.ts"
    },
    "scripts": {
        "typecheck": "node api-docs.ts && tsc --noEmit",
        "lint:check": "biome check && node i18n-check.ts",
        "lint:fix": "biome lint --fix && biome format --fix",
        "test": "node --test *.test.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@flippo-software/biome": "catalog:",
        "@storybook/blocks": "8.6.14",
        "@storybook/preview-api": "8.6.14",
        "@storybook/theming": "8.6.14",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "react": "catalog:",
        "typescript": "catalog:",
        "typescript5": "npm:typescript@5.9.3"
    }
}
