{
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "types": ["node", "react"],
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,
        "noUncheckedSideEffectImports": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules"]
}
